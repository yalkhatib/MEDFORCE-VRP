{
  "name": "@medforce/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "node dist/main.js",
    "seed": "ts-node src/database/seed.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate:postgres": "DB_TYPE=postgres typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate src/database/migrations/postgres/Schema",
    "migration:generate:mssql": "DB_TYPE=mssql typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate src/database/migrations/mssql/Schema",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@medforce/core": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/typeorm": "10.0.2",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "mssql": "11.0.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": "test/.*\\.e2e-spec\\.ts$",
    "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }] },
    "moduleNameMapper": { "^@medforce/core$": "<rootDir>/../../packages/core/src/index.ts" },
    "testTimeout": 30000
  }
}
